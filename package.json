{
  "name": "@rupertsworld/event-target",
  "version": "0.1.1",
  "type": "module",
  "description": "Typed EventTarget with convenient event type creation",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "type-check": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
